"VertexLitGeneric"
{
	// Стекло боковых окон салона. Текстура ТА ЖЕ, что у стёкол дверей (dglas.vmt):
	// берётся сама door_glass_frit, а не её копия. Lua берёт UV из прозрачной зоны атласа (без фритты),
	// $nomip держит верхний мип, чтобы на расстоянии стекло не темнело от чёрной фритты соседних областей.
	// Все остальные параметры - копия dglas.vmt.
	"$basetexture" "models/metrostroi_train/81-775/door_glass_frit"
	"$nomip" "1"
	"$translucent" "1"
	"$nocull" "1"
	"$model" "1"
	"$phong" "1"
	"$phongboost" "5"
	"$phongexponent" "80"
	"$phongfresnelranges" "[0.2 0.5 1]"
	"$envmap" "env_cubemap"
	"$envmaptint" "[0.225 0.225 0.24]"
}
