"VertexLitGeneric"
{
	"$basetexture"	"models/metrostroi_train/81-775/775_add_cabin"
	"$bumpmap"	"models/metrostroi_train/81-775/775_add_cabin_n"
	"$alphatest"	"1"
	"$model"	"1"

	// металлическая окрашенная панель: блик узкий и неяркий (было: exponent 40, boost 2.5, fresnel [0.4 0.8 2])
	// ширина блика - $phongexponent (больше = уже), яркость - $phongboost
	"$phong"	"1"
	"$phongexponent"	"70"
	"$phongboost"	"0.6"
	"$phongfresnelranges"	"[0.3 0.6 1]"
	"$phongtint"	"[0.85 0.88 0.95]"

	"$envmap"	"env_cubemap"
	"$envmaptint"	"[0.06 0.06 0.07]"
	"$envmapfresnel"	"0.5"

	"$surfaceprop"	"metal"
}
